# Privileged debug shell Pod for one bootc-mke3 node.
#
# Render with envsubst, which substitutes ${NODE_NAME} and nothing else:
#   NODE_NAME=<node> envsubst < debug-shell-pod.yaml.tmpl | kubectl apply -f -
#
# Runbook: docs/operations-guide/node-debug-shell.md
# Prerequisite: docs/operations-guide/privileged-support-containers.md
#
# EDIT BEFORE USE: the image tag must match the cluster's MKE version
# (docker version --format '{{.Server.Version}}' with the client bundle sourced
# reports e.g. ucp/3.9.5).
apiVersion: v1
kind: Pod
metadata:
  name: debug-shell-${NODE_NAME}
  namespace: cluster-support
  labels:
    app: node-debug-shell
spec:
  # Pinned to the node, which bypasses the scheduler: the shell reaches nodes
  # the scheduler would refuse, and needs no MKE scheduling grant.
  nodeName: ${NODE_NAME}
  restartPolicy: Never
  serviceAccountName: default
  # nsenter --target 1 needs the host PID namespace; it also gives the
  # container the host's process table.
  hostPID: true
  # Uncomment to share the node's network or IPC namespace as well — needed for
  # host-level tcpdump/ss output and for inspecting host shared memory.
  # hostNetwork: true
  # hostIPC: true
  tolerations:
    # No effect specified: tolerates the control-plane taint whether it is
    # NoSchedule or NoExecute, so the shell is not evicted from a manager.
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
  containers:
    - name: shell
      image: mirantis/ucp-dsinfo:3.9.5
      command: ["sleep", "infinity"]
      stdin: true
      tty: true
      securityContext:
        privileged: true
      volumeMounts:
        - name: host-root
          mountPath: /host
  volumes:
    - name: host-root
      hostPath:
        path: /
