# S3 credentials for the capture Job's optional S3 destination.
#
# Fill in the two values, then:
#   kubectl apply -f s3-credentials-secret.yaml
#
# Runbook: docs/operations-guide/collect-support-bundles.md
#
# The Job reads these as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env (see the
# commented S3 block in capture-job.yaml.tmpl). They never enter the script
# ConfigMap. Key names match what MKE's cluster-support tooling has always
# used, so an existing Secret can be reused as-is.
#
# Prefer creating it imperatively so the keys never land in a file:
#   kubectl -n cluster-support create secret generic s3-credentials \
#     --from-literal=accessKeyID=<key-id> \
#     --from-literal=secretAccessKey=<secret>
apiVersion: v1
kind: Secret
metadata:
  name: s3-credentials
  namespace: cluster-support
type: Opaque
stringData:
  accessKeyID: "<access-key-id>"
  secretAccessKey: "<secret-access-key>"
